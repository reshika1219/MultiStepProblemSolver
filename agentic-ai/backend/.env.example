ENV=dev
MONGO_URI=mongodb://localhost:27017
MONGO_DB=agentic_ai

# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Outside ENV=dev the server refuses to start with a weak/default secret.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Extra allowed browser origins, comma-separated (localhost is always allowed when ENV=dev)
CORS_ORIGINS=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
INSIGHT_VAULT_VERSION=v2025-10-13

RAG_LLM_MODEL=gpt-4.1
RAG_PLANNER_MODEL=gpt-4.1-mini
RAG_RERANK_MODEL=gpt-4.1-mini
RAG_ALLOW_GENERAL_KNOWLEDGE=true
RAG_MAX_GENERAL_PERCENT=0.25
